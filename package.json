{
  "name": "dandan-pet",
  "version": "0.2.3",
  "description": "轻量像素桌宠 蛋蛋 —— Electron 透明浮窗外壳",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "author": "topworld29",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "js-yaml": "^5.3.0",
    "ws": "^8.21.0"
  },
  "build": {
    "appId": "com.piggydanbo.dandan-pet",
    "productName": "蛋蛋桌宠",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "check-fullscreen.ps1",
      "renderer/**"
    ],
    "asarUnpack": [
      "check-fullscreen.ps1"
    ],
    "extraResources": [
      {
        "from": "dist-backend",
        "to": "backend"
      },
      {
        "from": "dist-opencode",
        "to": "opencode"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
